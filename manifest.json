{
  "manifest_version": 3,
  "name": "LeakAI - Data Loss Prevention",
  "version": "1.0.0",
  "description": "Real-time data loss prevention extension that detects and flags sensitive information as you type",
  
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "patterns/data-models.js",
        "patterns/email-detector.js",
        "patterns/phone-detector.js",
        "patterns/credit-card-detector.js",
        "patterns/api-key-detector.js",
        "patterns/crypto-detector.js",
        "patterns/ner-detector.js",
        "patterns/detection-engine.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  
  "background": {
    "service_worker": "background/background.js"
  },
  
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LeakAI Settings"
  },
  
  "web_accessible_resources": [
    {
      "resources": ["content/tooltip.html"],
      "matches": ["<all_urls>"]
    }
  ]
}