{
  "name": "leakai-chrome-extension",
  "version": "1.0.0",
  "description": "Chrome extension for real-time data loss prevention",
  "main": "manifest.json",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "jsdom": "^26.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "patterns/**/*.js",
      "!patterns/**/*.test.js"
    ]
  },
  "keywords": [
    "chrome-extension",
    "data-loss-prevention",
    "privacy",
    "security"
  ],
  "author": "LeakAI Team",
  "license": "MIT"
}
